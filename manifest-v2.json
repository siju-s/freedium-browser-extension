{
  "name": "Open in Freedium",
  "version": "1.2.0",
  "manifest_version": 2,
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "permissions": ["activeTab", "contextMenus", "storage"],
  "browser_action": {
    "default_title": "Open in Freedium"
  },
  "commands": {
    "convert-tab": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Open the current tab in Freedium"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "icons": {
    "32": "logo-32.png",
    "48": "logo-48.png",
    "64": "logo-64.png",
    "128": "logo-128.png"
  },
  "applications": {
    "gecko": {
      "id": "freedium-browser-extension@wywywywy.com"
    }
  },
  "content_security_policy": "script-src 'self'; object-src 'self'"
}
