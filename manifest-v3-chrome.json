{
  "name": "Open in Freedium",
  "version": "1.2.0",
  "manifest_version": 3,
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "contextMenus", "storage"],
  "host_permissions": [],
  "action": {
    "default_title": "Open in Freedium"
  },
  "commands": {
    "convert-tab": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Open the current tab in Freedium"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "icons": {
    "32": "logo-32.png",
    "48": "logo-48.png",
    "64": "logo-64.png",
    "128": "logo-128.png"
  }
}
